# ---- Core ----
ENV=development                 # development | production (production disables seeding and dev OTP echo)
SECRET_KEY=change-me-to-64-random-characters
DATABASE_URL=postgresql+psycopg://bizyukti:bizyukti@localhost:5432/bizyukti
REDIS_URL=redis://localhost:6379/0
TASKS_EAGER=false               # true runs background jobs inline (tests / single-process demo)
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_EMAILS=admin@bizyukti.in

# ---- Sign-in codes ----
OTP_DEV_ECHO=true               # MUST be false in production
SMS_PROVIDER=                   # e.g. msg91 / twilio; leave empty to log codes in development
SMS_API_KEY=
SMS_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BizYukti <no-reply@bizyukti.in>

# ---- Media storage ----
STORAGE_BACKEND=local           # local | s3
MEDIA_ROOT=./media
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# ---- Optional AI (falls back to built-in rules when empty) ----
ANTHROPIC_API_KEY=
LLM_MODEL=
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=

# ---- Web ----
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_ACCOUNTS=1     # shows demo persona shortcuts on the sign-in page
NEXT_PUBLIC_MAP_TILE_URL=       # production: a commercial tile provider (see README)
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ---- Production compose ----
SITE_DOMAIN=bizyukti.example.in
POSTGRES_PASSWORD=change-me
API_WORKERS=4
