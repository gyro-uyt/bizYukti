# Automatic HTTPS for SITE_DOMAIN. API and media go to FastAPI; everything else to Next.js.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip
	request_body /api/v1/properties/* {
		max_size 25MB
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /media/* {
		header Cache-Control "public, max-age=604800, immutable"
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output stdout
		format json
	}
}
